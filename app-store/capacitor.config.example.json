{
  "appId": "no.billigreiser.app",
  "appName": "Billig Reiser",
  "webDir": "www",
  "server": {
    "url": "https://billig-reiser.no",
    "cleartext": false
  },
  "ios": {
    "contentInset": "automatic",
    "scheme": "BilligReiser"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#020913",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#020913",
      "overlaysWebView": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
